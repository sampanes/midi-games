{
  "name": "midi-games",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "hooks": "git config core.hooksPath .githooks",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:py": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:app": "cd apps/key_games && fvm flutter test",
    "midi:analyze": "node ./scripts/analyze-midi-capabilities.mjs",
    "midi:listen": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Start-MidiListener.ps1",
    "midi:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Stop-MidiListener.ps1",
    "midi:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Get-MidiListenerStatus.ps1"
  }
}
